; API keys are NOT stored here. OPENAI_API_KEY (and optional OPENAI_BASE_URL)
; are loaded from ~/.secrets/api_keys.env.
[api]
base_url =

[translation]
model = gpt-4.1-mini
target_lang = English
threads = 4

context_size = 3

[glossary]
; comma-separated .md (table rows: | 日本語 | English |) or .yaml files
files = ~/Projects/lec-ml/2026/GLOSSARY-en.md, glossaries/lecture-extra.yaml
domain = machine learning
; today's slides (.md, comma-separated). Glossary terms that appear in them are passed to Whisper as hints
slides = ~/Projects/lec-ml/2026/004_polynomial_regression.md

[logging]
; each session writes <dir>/<timestamp>/{audio.wav, segments.jsonl, meta.json}
dir = transcripts
save_audio = true

[display]
display_duration = 10
window_width = 800
window_height = 120

[transcription]
backend = mlx
whisper_model = large-v3-turbo
funasr_model = iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
device = auto
compute_type = float16
source_language = ja
transcription_workers = 1

[audio]
; auto = system default input (microphone), blackhole = auto-detect BlackHole, or a device index
device_index = auto
sample_rate = 16000
silence_threshold = 0.005
silence_duration = 0.5
chunk_duration = 0.1
max_phrase_duration = 20
; short buffers (< segment_min_duration s) are cut only on a pause of long_silence_duration s
segment_min_duration = 4.0
long_silence_duration = 1.2
segment_soft_limit = 8.0
streaming_mode = true
streaming_interval = 3
streaming_step_size = 0.2
update_interval = 0.8
streaming_overlap = 0.3
