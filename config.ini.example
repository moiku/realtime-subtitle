; API keys are NOT stored here. OPENAI_API_KEY (and optional OPENAI_BASE_URL)
; are loaded from ~/.secrets/api_keys.env.
[api]
base_url =

[translation]
model = gpt-4.1-mini
target_lang = English
threads = 4

[display]
display_duration = 10
window_width = 800
window_height = 120

[transcription]
backend = mlx
whisper_model = large-v3-turbo
funasr_model = iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
device = auto
compute_type = float16
source_language = ja
transcription_workers = 1

[audio]
; auto = system default input (microphone), blackhole = auto-detect BlackHole, or a device index
device_index = auto
sample_rate = 16000
silence_threshold = 0.005
silence_duration = 0.5
chunk_duration = 0.1
max_phrase_duration = 30
streaming_mode = true
streaming_interval = 3
streaming_step_size = 0.2
update_interval = 0.8
streaming_overlap = 0.3
